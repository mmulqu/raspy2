# Letta Server Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM Provider API Keys
# ============================================================================
# These environment variables should be set when running your Letta server
# (via Docker environment variables or system environment)

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
GOOGLE_AI_API_KEY=...

# OpenRouter (access multiple models through one API)
OPENROUTER_API_KEY=sk-or-...

# Together AI
TOGETHER_API_KEY=...

# Groq
GROQ_API_KEY=gsk_...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# xAI (Grok)
XAI_API_KEY=xai-...

# ============================================================================
# Local Model Providers (URLs)
# ============================================================================

# Ollama (local models)
# For Docker: use host.docker.internal
# For Linux with --network host: use localhost
OLLAMA_BASE_URL=http://host.docker.internal:11434

# LM Studio (local models)
LMSTUDIO_BASE_URL=http://host.docker.internal:1234

# vLLM (self-hosted)
VLLM_BASE_URL=http://your-vllm-server:8000

# ============================================================================
# Letta Server Settings
# ============================================================================

# Enable password protection
SECURE=true

# Server password (used in Authorization header)
LETTA_SERVER_PASSWORD=yourpassword

# API token for programmatic access
LETTA_API_TOKEN=sk-let-YjM2Y2ZjYzQtNWM0NC00ZDRiLTg4NWItZjUxYjIxYzAyM2UzOjE4ZmVmYzUzLWI0ODUtNDIyNy04YTQyLTFhMzZiZDU3MDAyYQ==

# Default project
LETTA_PROJECT=default

# Agent ID (your main agent)
LETTA_AGENT_ID=agent-a0b842d2-f808-47bd-b477-bb85ca1e7d00

# Server port
LETTA_PORT=8283

# ============================================================================
# Database Configuration (Optional)
# ============================================================================

# PostgreSQL connection (if using external DB)
# LETTA_PG_DB=letta
# LETTA_PG_USER=letta
# LETTA_PG_PASSWORD=letta
# LETTA_PG_HOST=localhost
# LETTA_PG_PORT=5432

# ============================================================================
# Tool Execution (Optional)
# ============================================================================

# E2B API for sandboxed tool execution
# E2B_API_KEY=...
# E2B_SANDBOX_TEMPLATE_ID=...

# ============================================================================
# Usage Notes
# ============================================================================
#
# Docker Usage:
#   docker run \
#     -v ~/.letta/.persist/pgdata:/var/lib/postgresql/data \
#     -p 8283:8283 \
#     --env-file .env \
#     letta/letta:latest
#
# The frontend (letta-frontend.html) will automatically discover all
# available models through the /v1/models endpoint based on which
# API keys you've configured above.
#
